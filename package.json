{
  "name": "sathishkumar5115-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:pinned": "node scripts/check-pinned.mjs",
    "ci": "npm run check:pinned && npm run check:no-array-ui && npm run check:resume && npm run check:employer && npm run check && npm run test:unit && npm run build && npm run check:built && npm run test:e2e && npm run test:e2e:blog",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:resume": "node scripts/resume.mjs check",
    "build:resume": "node scripts/build-resume.mjs",
    "check:no-array-ui": "node scripts/check-no-array-ui.mjs",
    "test:e2e:blog": "BLOG_FIXTURES=1 npm run build && playwright test -c playwright.blog.config.ts",
    "check:employer": "node scripts/check-site.mjs employer",
    "check:built": "node scripts/check-site.mjs links dist && node scripts/check-site.mjs js dist && node scripts/check-site.mjs analytics dist absent",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "pagefind": "1.5.2",
    "pdf-lib": "1.17.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
