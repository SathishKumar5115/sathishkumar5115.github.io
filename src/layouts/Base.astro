---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import { site } from '../config';
import { PALETTES } from '../lib/palette';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; searchable?: boolean; kind?: 'Page' | 'Project' | 'Post'; }
const { title, description = 'Sathishkumar R: learning to build software that works.', searchable = true, kind = 'Page' } = Astro.props;
const analytics = process.env.ANALYTICS === '1' && site.analytics.goatcounterCode;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---
<!doctype html>
<html lang="en" data-palette={site.defaultPalette} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ defaultPalette: site.defaultPalette, palettes: [...PALETTES] }}>
      // Runs before first paint: palette (?palette=<name>|reset) and theme (stored, else system).
      (function () {
        var root = document.documentElement;
        var palette = defaultPalette, mode = null;
        try {
          var q = new URLSearchParams(location.search).get('palette');
          if (q === 'reset') localStorage.removeItem('sk-pal');
          else if (palettes.indexOf(q) > -1) localStorage.setItem('sk-pal', q);
          var p = localStorage.getItem('sk-pal');
          if (palettes.indexOf(p) > -1) palette = p;
          var m = localStorage.getItem('sk-mode');
          if (m === 'light' || m === 'dark') mode = m;
        } catch (e) {}
        if (!mode) mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.palette = palette;
        root.dataset.theme = mode;
      })();
    </script>
    {analytics && <script is:inline async data-goatcounter={`https://${analytics}.goatcounter.com/count`} src="//gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body={searchable ? '' : undefined} data-pagefind-meta={searchable ? `type:${kind}` : undefined}>
      {searchable && <span hidden data-pagefind-meta={`summary:${description}`}></span>}
      <slot />
    </main>
    <Footer />
  </body>
</html>
