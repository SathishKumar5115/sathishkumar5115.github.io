---
// Page shell (v5): fonts, tokens, base styles, theme bootstrap, SEO, skip link, header, footer.
import "@fontsource-variable/instrument-sans/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../design/tokens.css";
import "../design/base.css";
import fontUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import Seo from "../components/Seo.astro";
import Footer from "../components/ui/Footer.astro";
import Header from "../components/ui/Header.astro";
import ThemeScript from "../components/ui/ThemeScript.astro";
import { site, type NavLink } from "../config";
import { getCollection } from "astro:content";
import { getPublishedPosts } from "../lib/blog";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article" | "profile" | undefined;
  jsonLd?: Record<string, unknown> | undefined;
  footerNote?: string | undefined;
  /** Include this page's main content in the site search (Pagefind). */
  searchable?: boolean | undefined;
}

const { title, description, type, jsonLd, footerNote, searchable = true } = Astro.props;

// Analytics only in the deployed build, never in dev, PR builds or the fixture build (tech spec §10).
const goatcounter: string = site.analytics.goatcounterCode;
const analytics = process.env["ANALYTICS"] === "1" && goatcounter !== "";

// The blog appears only once a post is published (PRD R10): nav link, feed link, footer RSS.
const hasPosts = (await getPublishedPosts()).length > 0;
// Shelf appears once it has an entry (PRD P9).
const hasShelf = (await getCollection("shelf")).length > 0;
const extra: NavLink[] = [
  ...(hasPosts ? [{ label: "Writing", href: "/blog/" }] : []),
  ...(hasShelf ? [{ label: "Shelf", href: "/shelf/" }] : []),
];
const nav: NavLink[] = site.nav.flatMap((link, i) => (i === 0 ? [link, ...extra] : [link]));
const footerLinks = hasPosts ? [...site.social, { label: "RSS", href: "/rss.xml" }] : [...site.social];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} type={type} jsonLd={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {hasPosts && <link rel="alternate" type="application/rss+xml" title={`${site.name} · Writing`} href="/rss.xml" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header name={site.name} initials={site.initials} links={nav} currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? "" : undefined}>
      <slot />
    </main>
    {
      analytics && (
        <script
          is:inline
          async
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
    <Footer name={site.name} email={site.email} links={footerLinks} note={footerNote} />
  </body>
</html>
