---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts } from '../../lib/posts';

const posts = publishedPosts(await getCollection('posts'));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Blog" description="Posts on what I build and learn.">
  <div class="wrap page">
    <h1 class="page-title">Blog</h1>
    <p class="page-lede page-lede-wide">Posts on what I build and learn. I would rather write them carefully than quickly, so this starts empty.</p>
    {posts.length === 0 ? (
      <div class="empty">
        <p class="empty-title">No posts yet</p>
        <p class="empty-text">The first one is being written. In the meantime, see what I am working on.</p>
        <span class="empty-links"><a href="/projects/">Projects</a><a href="/now/">Now</a></span>
      </div>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li><span class="meta">{fmt(p.data.date)}</span><a href={`/blog/${p.id}/`}>{p.data.title}</a><span class="post-summary">{p.data.summary}</span></li>
        ))}
      </ul>
    )}
  </div>
</Base>
