---
// Not-found page (PRD P8). GitHub Pages serves dist/404.html for unknown URLs.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
---

<BaseLayout title={`Page not found · ${site.name}`} description="This page doesn't exist.">
  <div class="aui-container aui-prose">
    <h1>Page not found</h1>
    <p>That page doesn't exist, or it moved.</p>
    <ul>
      <li><a href="/">Go to the home page</a></li>
      <li><a href="/projects/">See all projects</a></li>
    </ul>
  </div>
</BaseLayout>
