---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" searchable={false}>
  <div class="wrap page">
    <p class="kicker">404</p>
    <h1 class="page-title">Page not found</h1>
    <p class="page-lede">That page does not exist or has moved. Try one of these instead.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/projects/">Projects</a>
    </div>
  </div>
</Base>
