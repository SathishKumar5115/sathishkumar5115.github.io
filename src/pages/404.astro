---
// Not-found page (PRD P8). GitHub Pages serves dist/404.html for unknown URLs.
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
---

<BaseLayout title={`Page not found · ${site.name}`} description="This page doesn't exist." searchable={false}>
  <div class="container wrap">
    <p class="mono muted code">404</p>
    <h1 class="page-title">Page not found</h1>
    <p class="lead">That page doesn't exist, or it moved.</p>
    <div class="actions">
      <Button href="/" variant="primary">Go to the home page</Button>
      <Button href="/projects/">See all projects</Button>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-top: 96px;
    padding-bottom: 120px;
  }
  .code {
    margin-bottom: 12px;
    font-size: 14px;
  }
  .page-title {
    margin-bottom: 12px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
