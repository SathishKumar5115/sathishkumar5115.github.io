---
// Home (v5): intro and "Now" card, featured projects, more projects. Writing (M4) and the shelf
// preview (M4.5) appear here once they have content.
import { getCollection } from "astro:content";
import { shelfTypeLabels, sortShelf } from "../lib/shelf";
import ProjectCard from "../components/project/ProjectCard.astro";
import Button from "../components/ui/Button.astro";
import PostRow from "../components/blog/PostRow.astro";
import ListRow from "../components/ui/ListRow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
import { getPublishedPosts } from "../lib/blog";
import { personJsonLd } from "../lib/person";
import { featuredProjects, projectYears, sortProjects } from "../lib/projects";

const projects = await getCollection("projects");
const featured = featuredProjects(projects);
const more = sortProjects(projects.filter((p) => !p.data.featured));
const latestPosts = (await getPublishedPosts()).slice(0, 3);
const shelfPreview = sortShelf(await getCollection("shelf")).slice(0, 3);
const updated = new Date(site.now.updated).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
---

<BaseLayout title={site.name} description={site.description} jsonLd={personJsonLd}>
  <div class="container">
    <section class="intro">
      <div class="intro-main">
        <p class="eyebrow-line mono muted">{site.role} @ {site.employer}</p>
        <h1 class="name">{site.name}</h1>
        <p class="pitch">{site.pitch}</p>
        <div class="actions">
          <Button href="/projects/" variant="primary">View projects</Button>
          <Button href={site.resume.href}>Resume (PDF)</Button>
          <span class="text-links">
            {site.social.map((s) => <a href={s.href}>{s.label}</a>)}
            <a href={`mailto:${site.email}`}>Email</a>
          </span>
        </div>
      </div>
      <aside class="now" aria-labelledby="now-heading">
        <h2 id="now-heading" class="eyebrow">Now</h2>
        <dl>
          {
            site.now.items.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd class="muted">{item.detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="updated mono muted">Updated <time datetime={site.now.updated}>{updated}</time></p>
      </aside>
    </section>

    <section aria-labelledby="featured-heading" class="block">
      <div class="block-head">
        <h2 id="featured-heading" class="section-title">Featured projects</h2>
        <a href="/projects/" class="link-accent">All projects →</a>
      </div>
      <div class="grid" data-project-list>
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <div class:list={["lists", { "two-col": latestPosts.length > 0 }]}>
      {
        latestPosts.length > 0 && (
          <section aria-labelledby="writing-heading" class="block" data-latest-posts>
            <h2 id="writing-heading" class="section-title">Writing</h2>
            <ol class="rows">
              {latestPosts.map((post) => (
                <PostRow post={post} showDescription={false} />
              ))}
            </ol>
            <p class="all"><a href="/blog/" class="link-accent">All writing →</a></p>
          </section>
        )
      }
      <section aria-labelledby="more-heading" class="block">
        <h2 id="more-heading" class="section-title">More projects</h2>
        <ul class="rows" data-more-projects>
          {
            more.map((p) => (
              <ListRow meta={projectYears(p.data.started, p.data.updated, p.data.status)}>
                <a href={`/projects/${p.id}/`} class="row-title">{p.data.title}</a>
                <span class="muted"> · {p.data.summary}</span>
              </ListRow>
            ))
          }
        </ul>
      </section>
    </div>

    {
      shelfPreview.length > 0 && (
        <section aria-labelledby="shelf-heading" class="block" data-shelf-preview>
          <div class="block-head">
            <h2 id="shelf-heading" class="section-title">On the shelf</h2>
            <a href="/shelf/" class="link-accent">The whole shelf →</a>
          </div>
          <ul class="rows">
            {shelfPreview.map((e) => (
              <ListRow meta={shelfTypeLabels[e.data.type].replace(/s$/, "")}>
                <a href={e.data.url} class="row-title">{e.data.name}</a>
                <span class="muted"> · {e.data.note}</span>
              </ListRow>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
    padding: 80px 0 72px;
  }
  .intro-main {
    flex: 999 1 520px;
    min-width: 0;
  }
  .eyebrow-line {
    font-size: 13px;
    margin-bottom: 18px;
  }
  .name {
    font-size: clamp(36px, 6vw, 48px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 18px;
  }
  .pitch {
    font-size: 20px;
    line-height: 1.5;
    color: var(--text-soft);
    max-width: 580px;
    margin-bottom: 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }
  .text-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-left: 8px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .text-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .text-links a:hover {
    color: var(--text);
  }
  .now {
    flex: 1 1 300px;
    min-width: 0;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .now h2 {
    margin-bottom: 14px;
  }
  .now dl {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
  }
  .now dt {
    font-weight: 600;
  }
  .now dd {
    margin: 0;
  }
  .updated {
    margin-top: 16px;
    font-size: 12px;
  }
  .block {
    padding-bottom: 72px;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }
  .block > .section-title {
    margin-bottom: 12px;
  }
  .lists.two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .all {
    margin-top: 14px;
    font-size: 15px;
  }
  .rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
    max-width: 820px;
  }
  .row-title {
    font-weight: 600;
  }
</style>
