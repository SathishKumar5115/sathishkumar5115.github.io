---
import { getCollection } from "astro:content";
import ProjectCard from "../components/project/ProjectCard.astro";
import Hero from "../components/ui/Hero.astro";
import SocialPill from "../components/ui/SocialPill.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
import { featuredProjects } from "../lib/projects";
import { personJsonLd } from "../lib/person";

const featured = featuredProjects(await getCollection("projects"));
---

<BaseLayout title={site.name} description={site.description} jsonLd={personJsonLd}>
  <div class="aui-container">
    <Hero title={site.name} subtitle={site.tagline}>
      <p>{site.intro}</p>
      <Fragment slot="socials">
        {site.social.map((s) => <SocialPill href={s.href} label={s.label} platform={s.platform} />)}
      </Fragment>
    </Hero>
    <section aria-labelledby="featured-heading">
      <h2 id="featured-heading">Featured projects</h2>
      <div class="aui-stack" data-project-list>
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
      <p><a href="/projects/">All projects →</a></p>
    </section>
  </div>
</BaseLayout>
