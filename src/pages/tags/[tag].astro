---
// Posts for one tag. Built only for tags used by published posts.
import PostRow from "../../components/blog/PostRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config";
import { allTags, getPublishedPosts } from "../../lib/blog";
import { tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return allTags(posts).map((t) => ({
    params: { tag: t.slug },
    props: { tag: t.tag, posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === t.slug)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Posts about ${tag} · ${site.name}`} description={`Posts tagged “${tag}”.`}>
  <div class="container">
    <div class="narrow">
      <section class="head">
        <p class="back"><a href="/blog/" class="muted">← All writing</a></p>
        <h1 class="page-title">Posts about {tag}</h1>
      </section>
      <ol class="rows">
        {posts.map((post) => <PostRow post={post} />)}
      </ol>
    </div>
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 760px;
    padding-bottom: 88px;
  }
  .head {
    padding: 48px 0 28px;
  }
  .back {
    margin-bottom: 20px;
    font-size: 15px;
  }
  .rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
</style>
