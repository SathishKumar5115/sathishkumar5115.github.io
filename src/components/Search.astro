---
---
<button type="button" class="search-btn" data-search-open aria-label="Search" aria-keyshortcuts="/">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
  <span class="search-label">Search</span>
  <kbd aria-hidden="true">/</kbd>
</button>

<dialog class="search" data-search-dialog aria-label="Search the site">
  <div class="search-field">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
    <label for="site-search" class="sr-only">Search the site</label>
    <input id="site-search" type="search" autocomplete="off" spellcheck="false" placeholder="Search projects and pages" role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" />
    <kbd aria-hidden="true">Esc</kbd>
  </div>
  <div class="search-results" id="search-results" role="listbox" aria-label="Results"></div>
  <p class="search-empty" data-search-empty hidden>No results. Try a project name, a tool, or a page.</p>
  <div class="search-foot" aria-hidden="true"><span>↑↓ to move</span><span>↵ to open</span><span>Esc to close</span></div>
</dialog>

<script>
  interface PagefindResult { url: string; excerpt: string; meta: { title?: string; type?: string; summary?: string } }
  interface Pagefind {
    search: (q: string | null) => Promise<{ results: { data: () => Promise<PagefindResult> }[] }>;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')!;
  const input = dialog.querySelector<HTMLInputElement>('input')!;
  const list = dialog.querySelector<HTMLElement>('[role="listbox"]')!;
  const empty = dialog.querySelector<HTMLElement>('[data-search-empty]')!;

  const GROUPS: [string, string][] = [['Project', 'PROJECTS'], ['Page', 'PAGES'], ['Post', 'BLOG POSTS']];
  let pagefind: Pagefind | null | undefined;
  let ticket = 0;
  let active = -1;

  async function load(): Promise<Pagefind | null> {
    if (pagefind !== undefined) return pagefind;
    try {
      const url = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
    } catch {
      pagefind = null;
    }
    return pagefind;
  }

  const rows = () => Array.from(list.querySelectorAll<HTMLAnchorElement>('a[role="option"]'));

  function setActive(i: number) {
    const r = rows();
    if (!r.length) { active = -1; input.removeAttribute('aria-activedescendant'); return; }
    active = (i + r.length) % r.length;
    r.forEach((el, n) => el.setAttribute('aria-selected', String(n === active)));
    input.setAttribute('aria-activedescendant', r[active].id);
    r[active].scrollIntoView({ block: 'nearest' });
  }

  function plain(html: string): string {
    const el = document.createElement('div');
    el.innerHTML = html;
    return el.textContent ?? '';
  }

  function render(items: PagefindResult[]) {
    list.replaceChildren();
    let n = 0;
    for (const [type, label] of GROUPS) {
      const group = items.filter((i) => (i.meta.type ?? 'Page') === type);
      if (!group.length) continue;
      const box = document.createElement('div');
      box.className = 'search-group';
      box.setAttribute('role', 'group');
      box.setAttribute('aria-label', label.toLowerCase());
      const head = document.createElement('div');
      head.className = 'search-group-label';
      head.setAttribute('aria-hidden', 'true');
      head.textContent = label;
      box.append(head);
      for (const item of group) {
        const a = document.createElement('a');
        a.className = 'search-row';
        a.href = item.url;
        a.id = `search-opt-${n++}`;
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', 'false');
        const text = document.createElement('span');
        const t = document.createElement('span');
        t.className = 'search-row-title';
        t.textContent = item.meta.title ?? item.url;
        const l = document.createElement('span');
        l.className = 'search-row-line';
        l.textContent = item.meta.summary ?? plain(item.excerpt);
        text.append(t, l);
        const kind = document.createElement('span');
        kind.className = 'search-row-type';
        kind.setAttribute('aria-hidden', 'true');
        kind.textContent = type;
        a.append(text, kind);
        box.append(a);
      }
      list.append(box);
    }
    empty.hidden = items.length > 0;
    setActive(items.length ? 0 : -1);
  }

  async function run() {
    const mine = ++ticket;
    const lib = await load();
    if (!lib) {
      list.replaceChildren();
      empty.textContent = 'Search is available on the built site.';
      empty.hidden = false;
      return;
    }
    const q = input.value.trim();
    const found = await lib.search(q || null);
    const items = await Promise.all(found.results.slice(0, 12).map((r) => r.data()));
    if (mine === ticket) render(items);
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.focus();
    void run();
  }

  document.querySelector('[data-search-open]')?.addEventListener('click', open);
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
    e.preventDefault();
    open();
  });
  input.addEventListener('input', () => void run());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') { const r = rows()[active]; if (r) { e.preventDefault(); r.click(); } }
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { input.value = ''; });
</script>
