---
// Initials avatar (PRD R11). Array UI has no Astro avatar, so this is our own markup.
// Without a label it's decorative (hidden from assistive tech).
interface Props {
  initials: string;
  label?: string;
}

const { initials, label } = Astro.props;
---

{
  label ? (
    <span class="site-avatar" role="img" aria-label={label}>{initials}</span>
  ) : (
    <span class="site-avatar" aria-hidden="true">{initials}</span>
  )
}
