---
// Site header. Own markup with array-ui's TopNav classes: upstream's menu button
// lacks aria-expanded/aria-controls (tech spec §11).
import type { NavLink } from "../../config";
import Avatar from "./Avatar.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  name: string;
  initials: string;
  links: readonly NavLink[];
  currentPath: string;
}

const { name, initials, links, currentPath } = Astro.props;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="aui-topnav aui-topnav-sticky">
  <div class="aui-topnav-container aui-container">
    <div class="aui-topnav-left">
      <a href="/" class="aui-topnav-brand">
        <Avatar initials={initials} />
        <span class="aui-topnav-brand-meta">
          <span class="aui-topnav-title">{name}</span>
        </span>
      </a>
      <nav class="aui-topnav-links" aria-label="Main">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={["aui-topnav-link", { "is-active": isActive(link.href) }]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="aui-topnav-right">
      <ThemeToggle />
      <button
        type="button"
        class="aui-topnav-burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        data-menu-toggle
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12h18M3 6h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav id="site-mobile-menu" class="aui-topnav-mobile-menu" aria-label="Main (mobile)">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={["aui-topnav-mobile-link", { "is-active": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("site-mobile-menu");
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(open));
    menu?.classList.toggle("is-open", open);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      button.setAttribute("aria-expanded", "false");
      menu?.classList.remove("is-open");
      button.focus();
    }
  });
</script>
