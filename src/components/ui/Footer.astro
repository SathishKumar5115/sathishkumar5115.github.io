---
// Site footer (v5): copyright and contact links on one line.
interface Props {
  name: string;
  email: string;
  links: readonly { label: string; href: string }[];
  note?: string | undefined;
}

const { name, email, links, note } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="container">
  <div class="footer">
    <span>© {year} {name}{note && ` · ${note}`}</span>
    <span class="links">
      <a href={`mailto:${email}`}>{email}</a>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: 28px;
    padding-bottom: 44px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  .footer a:hover {
    color: var(--text);
  }
</style>
