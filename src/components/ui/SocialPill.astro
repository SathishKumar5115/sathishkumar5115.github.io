---
// Wrapper for array-ui's SocialPill (swap point, tech spec §7.1).
import type { ComponentProps } from "astro/types";
import Aui from "array-ui/astro/SocialPill.astro";

type Props = ComponentProps<typeof Aui>;
---

<Aui {...Astro.props}>
  {Astro.slots.has("icon") && <slot name="icon" slot="icon" />}
  <slot />
</Aui>
