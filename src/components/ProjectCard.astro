---
import Tag from './Tag.astro';
interface Props { title: string; tag: string; year: string; summary: string; href: string; }
const { title, tag, year, summary, href } = Astro.props;
---
<article class="card">
  <Tag>{tag} · {year}</Tag>
  <h3>{title}</h3>
  <p>{summary}</p>
  <a href={href}>Read the write-up</a>
</article>
