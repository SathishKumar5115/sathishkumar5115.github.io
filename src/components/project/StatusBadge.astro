---
import Tag from "../ui/Tag.astro";
import type { ProjectStatus } from "../../content/schemas";
import { statusBadge } from "../../lib/projects";

interface Props {
  status: ProjectStatus;
}

const { label, tone } = statusBadge[Astro.props.status];
---

<Tag tone={tone} data-status={Astro.props.status}>{label}</Tag>
