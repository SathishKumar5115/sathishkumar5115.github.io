---
import Badge from "../ui/Badge.astro";
import type { ProjectStatus } from "../../content/schemas";
import { statusBadge } from "../../lib/projects";

interface Props {
  status: ProjectStatus;
}

const { label, variant } = statusBadge[Astro.props.status];
---

<Badge variant={variant} data-status={Astro.props.status}>{label}</Badge>
